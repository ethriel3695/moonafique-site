# WorkOS Configuration
WORKOS_API_KEY="sk_test_..."
WORKOS_CLIENT_ID="client_..."
WORKOS_COOKIE_PASSWORD="replace-with-a-random-32-char-secret"
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"
NEXT_PUBLIC_WORKOS_LOGOUT_REDIRECT_URI="http://localhost:3000"

# Optional: set this route in the WorkOS dashboard as the sign-in endpoint
# http://localhost:3000/sign-in

# Database Configuration
# DATABASE_URL="postgres://user:password@host:5432/database"

# Next.js Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SERVER_URL="http://localhost:3000"

# Stripe Configuration
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Shippo: use shippo_test_... in sandbox and shippo_live_... in Production.
# Keep the key server-only. Ship-from address and package profiles are configured
# in lib/grimmunity/shipping-profile.ts. Quotes never purchase postage.
SHIPPO_API_KEY="shippo_test_..."
# Optional business shipping contact phone, if required by a selected carrier.
SHIPPO_FROM_PHONE=""

# Resend Configuration
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Moonafique <noreply@moonafique.com>"
# Optional: add subscribers to a Resend Segment for future broadcasts
# RESEND_NEWSLETTER_SEGMENT_ID="seg_..."

# Optional: Analytics and Monitoring
# NEXT_PUBLIC_ANALYTICS_ID="your_analytics_id"

# Grimmunity: separate storage and Stripe credentials. Never use NEXT_PUBLIC_ for secrets.
# Start with a dedicated sandbox database. The legacy DATABASE_URL is not used by this feature.
GRIM_MODE="sandbox"
GRIM_DATABASE_URL="postgres://user:password@localhost:5432/grim_sandbox"
GRIM_STRIPE_SECRET_KEY="sk_test_..."
GRIM_STRIPE_WEBHOOK_SECRET="whsec_..."
# Comma-separated WorkOS user IDs, never email addresses or browser-supplied roles.
GRIM_STAFF_USER_IDS="user_..."
# Dedicated webhook: /api/grimmunity/webhook. Set true only for a deliberately shared account/endpoint.
GRIM_USE_SHARED_WEBHOOK="false"
# These stay disabled until explicit owner authorization and production verification.
GRIM_LIVE_ENROLLMENT="disabled"
GRIM_SEND_EMAILS="disabled"
GRIM_MANAGED_COLLECTION="disabled"
# Dedicated Resend delivery webhook for /api/grimmunity/notice-delivery.
# A verified delivery receipt is required before any renewal can auto-charge.
GRIM_RESEND_WEBHOOK_SECRET=""
# Sandbox notification worker refuses to send without an explicit test destination.
GRIM_TEST_EMAIL=""
# Development-only static fixture screens; always unavailable in production.
GRIM_REVIEW_UI="false"
# Email-only launch interest list, independent of paid enrollment.
GRIM_INTEREST_ENABLED="false"
GRIM_SEND_INTEREST_EMAILS="disabled"
CUSTOM_REQUEST_SEND_EMAILS="disabled"
CUSTOM_REQUEST_STAFF_EMAIL="hello@moonafique.com"
# When sandbox delivery is approved, all custom emails go only to this test inbox.
CUSTOM_REQUEST_TEST_EMAIL=""
# Required for interest and custom-request abuse protection in each environment.
# Use a different random value for Preview and Production.
GRIM_INTEREST_SECRET="replace-with-a-random-secret-at-least-32-characters"
GRIM_SITE_URL="http://localhost:3000"
# Authenticates the daily Vercel worker. Never expose this to a browser.
CRON_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
# Vercel integration identity guard; copy the connected Neon project ID.
GRIM_EXPECTED_NEON_PROJECT_ID="replace-with-project-id"
